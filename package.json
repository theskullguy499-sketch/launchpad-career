{
  "name": "launchpad-career",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run build && npm run test:build && npm run test:db && npm run test:backend && playwright test && npm run test:production",
    "start": "node scripts/serve-production.cjs --source",
    "test:db": "node --test supabase/tests/*.test.cjs",
    "build:check": "node scripts/build.cjs --check",
    "test:production": "playwright test --config playwright.production.config.js",
    "test:build": "node --test scripts/*test.cjs",
    "test:backend": "node scripts/check-functions.cjs && node --test tests-unit/*.test.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "build:staging": "node scripts/build-staging.cjs",
    "check:staging": "node scripts/check-staging.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "axe-core": "4.10.3",
    "esbuild": "0.28.2"
  },
  "version": "5.3.0-rc.1"
}
